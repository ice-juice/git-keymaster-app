{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "御钥师",
  "mainBinaryName": "git-keymaster",
  "version": "1.8.1",
  "identifier": "com.jeck.gitkeymaster",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "御钥师",
        "width": 980,
        "height": 620,
        "minWidth": 840,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "zh_CN.lproj/InfoPlist.strings": "zh_CN.lproj/InfoPlist.strings",
      "en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "template": "windows/installer.nsi"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/git-keymaster.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/git-keymaster.desktop"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QkVGMDgxQkQ1OEFBNkMKUldSc3FsaTlnZkMreCtDZ0F4Y290SUM1d3lYemwzcjJuOVdEOXEwOGR3Zi9hSnJZMkdHREgzZ1cK",
      "endpoints": [
        "https://github.com/ice-juice/git-keymaster-app/releases/latest/download/latest.json"
      ]
    }
  }
}